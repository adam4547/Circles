{
  "name": "circles",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop app that shows how friend groups overlap",
  "author": "Circles",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "d3": "^7.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "build": {
    "appId": "com.circles.app",
    "productName": "Circles",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Circles.exe"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
